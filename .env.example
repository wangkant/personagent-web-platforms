# Mibo settings. The app fills in the first block for you.
# Each setting is described on the lines above it; a blank value means the
# default the description gives.

# ============================================================================
# REQUIRED
# ============================================================================

# The chat model: any OpenAI-compatible service, hosted or local (Ollama).
LLM_API_KEY=
# The API address as the provider documents it: a root such as
# https://api.deepseek.com, a version base such as .../v1 or .../api/paas/v4,
# or the full /chat/completions URL. Blank = https://api.deepseek.com.
LLM_BASE_URL=https://openrouter.ai/api/v1
# The model id as the service names it. openrouter/free, which the page
# writes here, sends each request to one of OpenRouter's free models (50
# requests a day). Blank = deepseek-flash.
LLM_MODEL=openrouter/free

# The character's name.
PERSONA_NAME=
# The portrait the local page shows: chatgpt, deepseek or claude; own = the
# picture chosen on the page (avatar.png, .jpg or .webp in this folder). Blank =
# the name's first letter.
PERSONA_AVATAR=

# Language of the agent: en, zh, zh-TW, ja, ko, es, fr, de, pt-BR or ru. Sets
# the starter persona, the terminal text and the words its commands understand.
# The bundled output filter is data/output_filter.zh.json for zh and zh-TW and
# data/output_filter.en.json for the others. It does not translate your persona.
AGENT_LANG=en

# Language of the app's own screens, menus and messages, from the same ten.
# Settings > Language sets it. Blank = the language of the agent.
UI_LANG=

# ============================================================================
# PERSONA
# ============================================================================

# The persona document, and its optional companion card, both relative to
# AGENT_HOME. Until persona.txt exists, the shipped character Mibo stands in.
# The card holds the persona's reply style, such as
# {"reply_style": {"emoji": true, "max_chars": 320}}: whether emoji are part
# of how it writes, and the length its lines stay under. The prompt asks for
# both; nothing is cut. Without a card, no emoji. A `[style]` block at the end of the persona
# document sets the six register knobs: length, vent, recs, good_news,
# particles and fatigue.
PERSONA_FILE=persona.txt
PERSONA_CARD_FILE=persona.card.json

# The persona's time zone as a UTC offset in hours, from -12 to 14, such as
# 8 or -5. It sets the time shown to the model and the 02:00-07:00 sleep
# window, when the character asks after no plan. Blank = UTC+8 when
# AGENT_LANG is zh or zh-TW, this machine's offset otherwise.
PERSONA_TZ_OFFSET_HOURS=

# What the character calls the person at the app. Blank = not named in prompts.
ADMIN_NAME=
# What that person is to the character, such as brother, boss or friend.
# Blank = not mentioned in prompts.
ADMIN_RELATIONSHIP=

# ============================================================================
# THE PAGE
# ============================================================================

# The page listens on this computer only (127.0.0.1), opened through the link
# with its token. Its port; blank = a free one. The environment wins over this
# file, as for every setting here.
PAGE_PORT=

# ============================================================================
# UPDATES AND STORAGE
# ============================================================================

# The app asks the release page on GitHub at most once a day, in the background,
# whether a newer Mibo is out, and points to its installer there. The
# request carries only the version number. false never asks.
UPDATE_CHECK_ENABLED=true

# The home folder: .env, persona.txt and runtime/ are
# resolved under it. Blank = this checkout, else the working folder if it
# holds a home, else ~/mibo. AGENT_RUNTIME_DIR must stay beneath it.
AGENT_HOME=

# Everything the character remembers (memory, the person store) is
# written here, never into data/. Relative
# paths are under AGENT_HOME. runtime/ is gitignored; another folder inside a
# repository needs the same, because it holds real conversations.
AGENT_RUNTIME_DIR=runtime

# ============================================================================
# OPTIONAL FEATURES (safe to leave as they are)
# ============================================================================

# --- Model calls ---
# Per-request timeout in seconds, and retries after a transient error. A
# turn's model calls share 1.5 x LLM_TIMEOUT_S in all, retries included.
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# The main model's context window in tokens. Blank = the figure the host's model
# list states, else the one an overflow error named, else 32768 assumed. Fill it
# for a model on this computer or a host that lists none.
CONTEXT_WINDOW=
# Another model name for the chat's replies, served by the same endpoint and key as LLM_MODEL.
# The exception: a name equal to LLM_FALLBACK_MODEL is served where the
# fallback is. Blank = LLM_MODEL.
LLM_DM_MODEL=
# The model for the short calls beside a reply (folding memory, summing up a
# page). Blank = LLM_FALLBACK_MODEL, else the main model. Point it at the
# cheapest model you have.
LLM_JUDGE_MODEL=

# --- Fallback when busy (a cheaper model while the main one is loaded) ---
LLM_FALLBACK_MODEL=
# The fallback model's own endpoint. Blank = LLM_BASE_URL and LLM_API_KEY. Only a
# LLM_FALLBACK_MODEL different from LLM_MODEL is sent here, together with the
# judge calls whose model defaults to it. A blank key
# with a URL on another provider sends LLM_API_KEY there, so give it its own.
# Accepts the same spellings as LLM_BASE_URL.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# DeepSeek's `thinking` field turns hidden reasoning off for the short calls. DeepSeek, Zhipu, Moonshot and
# Volcengine hosts get it; OpenAI, Groq, Gemini, OpenRouter, Mistral and
# Anthropic do not; any other endpoint is asked on its first such call, and
# the answer is kept per model. true = send it to the fallback's host without
# asking. An endpoint that answers 400 to it is not sent it again.
LLM_FALLBACK_THINKING=false
LLM_FALLBACK_DURATION_S=180
# Seconds a model that answered 429 (rate limited) is skipped.
# Any other failure (a 400, retries used up) keeps the model out for
# LLM_FALLBACK_DURATION_S.
LLM_RATE_LIMIT_COOLDOWN_S=20

# The facts file under AGENT_RUNTIME_DIR, and how many facts each chat keeps;
# past that, the least useful notes the character wrote itself go first.
MEMORY_FILE=memory.json
MEMORY_MAX_PER_CONVERSATION=50
# Notes written in replies since the last consolidation that also start one.
# Zero turns off every memory model call.
MEMORY_TIDY_EVERY=8
# Model calls per day, for all chats together, that move conversation into
# long-term memory. Zero turns them off.
MEMORY_CALLS_PER_DAY=40
# Characters of remembered material placed in each reply: the summary of
# earlier conversation, facts and events.
MEMORY_PROMPT_CHARS=2400
# Events kept per chat before the least useful are removed.
MEMORY_EPISODES_MAX=120
# Keep the recent messages of each chat on disk for 72 hours, so that a
# restart does not lose them.
MEMORY_KEEP_RECENT=true
# Days each chat's record (in runtime/mibo.db) is kept, so that what the character
# remembers can be checked against what was said. Zero keeps no record and
# deletes the one kept; forgetting reaches it.
MEMORY_LOG_DAYS=30

# --- Web search (looks up unfamiliar things) ---
# Keyless by default (the `ddgs` dependency). A Brave Search or Tavily API key is
# entered in Settings › Going out and kept in the system's credential store, not here.

# --- Vision (pictures) ---
# Blank = no vision model: a picture goes to the reply model when it reads pictures. Any OpenAI-compatible
# vision model works; give it its provider's key and base URL here, since there
# is no default endpoint.
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=
# The largest decoded image accepted from base64, a file or HTTP, in bytes.
VISION_MAX_IMAGE_BYTES=5000000

# --- Walks ---
# The character goes out on its own as a signed-out visitor: it reads a few
# pages (Bilibili, YouTube and ordinary pages), keeps up to three and tells
# you about those that fit you. It needs a model and an installed Edge,
# Chrome or Chromium, and never goes out in its sleep hours.
ROAM_ENABLED=true
# Walks a day it starts itself, 0 to 6; a lookup asked in the chat may take one more.
ROAM_WALKS_A_DAY=3
# The day's first walk of its own leaves at this local time (HH:MM) or after; blank for any time.
ROAM_AT=
# Least time between two walks it starts itself, in hours (1 to 24).
ROAM_GAP_HOURS=3
# Most pages read in one walk, 3 to 12.
ROAM_PAGES_PER_WALK=8
# Most pages a day on any one site, 1 to 60.
ROAM_SITE_PAGES_A_DAY=30

# --- Retrieval by meaning (embeddings) ---
# What the character read on its walks is matched to a message by the words
# they share (BM25) and by how recent it is. An embedding model adds meaning:
# a thing that says the same in other words can match.
# Blank EMBEDDING_MODEL = off. Any OpenAI-compatible /embeddings endpoint
# works (OpenAI, SiliconFlow, Zhipu, a local Ollama). Vectors are cached in
# AGENT_RUNTIME_DIR/mibo.db. A reply waits at most 3 seconds for its
# message to be embedded; a slow or failing endpoint is logged once, and
# retrieval ranks without it until it answers.
EMBEDDING_MODEL=
# Blank = LLM_BASE_URL with LLM_API_KEY. A URL of its own gets only
# EMBEDDING_API_KEY (blank for an endpoint that needs no key). Accepts a root,
# a version base (/v1, /api/paas/v4) or the full /embeddings URL.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
